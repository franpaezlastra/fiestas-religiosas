# Local (`npm run dev`):
#   VITE_API_URL=/api/v1  → proxy en vite.config.js → api.fiestasreligiosas.com
#
# Producción (`npm run build` / DonWeb):
#   VITE_API_URL=https://api.fiestasreligiosas.com/api/v1
#   VITE_API_URL_PREVIEW=https://api-preview.fiestasreligiosas.com/api/v1
#   VITE_CLOUDINARY_CLOUD_NAME=m6cqtqba  (prod)
#   VITE_CLOUDINARY_CLOUD_NAME_PREVIEW=duuwqmpmn  (preview.* en runtime)
#   (preview.fiestasreligiosas.com elige API + Cloudinary PREVIEW vía apiClient.js / cloudinary.js)

VITE_API_URL=/api/v1
VITE_CLOUDINARY_CLOUD_NAME=m6cqtqba
VITE_CLOUDINARY_CLOUD_NAME_PREVIEW=duuwqmpmn

# Backend local sin proxy:
# VITE_API_URL=http://localhost:3000/api/v1

# Tienda: true = servicios simulados (src/services/shop/shopMock.js), sin backend ni cobros.
# Apagalo (false o borrala) cuando el backend tenga los endpoints de la tienda.
VITE_USE_MOCKS=false

# Comunidad: true = servicios simulados (src/services/community/communityMock.js), datos en este navegador.
# Independiente de VITE_USE_MOCKS: la tienda y la comunidad pasan al backend real en momentos distintos.
VITE_COMMUNITY_MOCKS=false

# Site key de Cloudflare Turnstile (captcha en registro y "olvidé mi contraseña"). Pública.
VITE_TURNSTILE_SITE_KEY=

# Novedades del libro (presentaciones, muestras, prensa): true = simuladas (src/services/novedades/novedadesMock.js).
# Independiente de la tienda y de la comunidad. Apagalo cuando el backend tenga /api/v1/public/book-news y /api/v1/admin/book-news.
VITE_NOVEDADES_MOCKS=false
