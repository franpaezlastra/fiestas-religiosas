# Local (`npm run dev`):
#   VITE_API_URL=/api/v1  → proxy en vite.config.js → api-preview.fiestasreligiosas.com
#
# Producción (`npm run build` / DonWeb):
#   VITE_API_URL=https://api.fiestasreligiosas.com/api/v1
#   VITE_API_URL_PREVIEW=https://api-preview.fiestasreligiosas.com/api/v1
#   VITE_CLOUDINARY_CLOUD_NAME=m6cqtqba  (prod)
#   VITE_CLOUDINARY_CLOUD_NAME_PREVIEW=duuwqmpmn  (preview.* en runtime)
#   (preview.fiestasreligiosas.com elige API + Cloudinary PREVIEW vía apiClient.js / cloudinary.js)

VITE_API_URL=/api/v1
VITE_CLOUDINARY_CLOUD_NAME=m6cqtqba
VITE_CLOUDINARY_CLOUD_NAME_PREVIEW=duuwqmpmn

# Backend local sin proxy:
# VITE_API_URL=http://localhost:3000/api/v1
