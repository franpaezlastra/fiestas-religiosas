# Local (`npm run dev`) → proxy Vite → api.fiestasreligiosas.com
VITE_API_URL=/api/v1
VITE_CLOUDINARY_CLOUD_NAME=m6cqtqba
VITE_CLOUDINARY_CLOUD_NAME_PREVIEW=duuwqmpmn

# Tienda simulada (sin backend). Ver .env.example
VITE_USE_MOCKS=true

# Comunidad simulada (sin backend). Ver .env.example
VITE_COMMUNITY_MOCKS=true

# Novedades del libro simuladas. Ver .env.example
VITE_NOVEDADES_MOCKS=true
